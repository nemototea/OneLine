<?xml version="1.0" encoding="utf-8"?><!--
   Android 11以下 (API 30以下) 向けの自動バックアップルール。
   Git認証トークンを含む設定DataStoreはバックアップに含めない。
   日記データ（diary_entries/ と OneLine_repository/）はバックアップ対象のまま。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
